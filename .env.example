# ── Local development ────────────────────────────────────────────────────────
# Leave both empty to use the built-in local database in .data/pglite and an auto-generated secret.

# Postgres connection string. Optional everywhere:
#  - Netlify: leave UNSET — Netlify Database is created on deploy and connected automatically (NETLIFY_DB_URL).
#  - Vercel / other hosts: set to a Neon (or any Postgres) connection string.
DATABASE_URL=

# Secret used to sign login cookies. Optional: if unset, a strong random secret is generated once and
# stored in the database. Set it yourself (any long random string) if you prefer to manage it.
JWT_SECRET=
